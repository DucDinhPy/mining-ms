# Leave empty when using the Vite WebSocket proxy to ws://127.0.0.1:8002
# Otherwise set only the origin, for example: ws://127.0.0.1:8002
VITE_PPE_WS_BASE_URL=

# Leave empty when using the Vite HTTP proxy to http://localhost:5057/api/cameras
VITE_CAMERA_API_URL=

# Leave empty when using the Vite HTTP proxy to http://127.0.0.1:8002/api/assistant
# Otherwise set only the origin, for example: http://127.0.0.1:8002
VITE_ASSISTANT_API_URL=
